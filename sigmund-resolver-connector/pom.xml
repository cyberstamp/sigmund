<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.cyberstamp.sigmund</groupId>
    <artifactId>sigmund-parent</artifactId>
    <version>0.0.3-SNAPSHOT</version>
  </parent>
  <artifactId>sigmund-resolver-connector</artifactId>
  <name>Sigmund :: Resolver Connector</name>
  <properties>
    <resolver.version>2.0.25</resolver.version>
    <maven.version>3.10.1</maven.version>
    <!-- The Maven distributions the ITs run on, whatever Maven runs this build -->
    <it.maven3.version>3.10.1</it.maven3.version>
    <it.maven4.version>4.0.0-rc-7</it.maven4.version>
    <sisu.version>1.1.2</sisu.version>
    <sl4j.version>2.0.20</sl4j.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>dev.cyberstamp.sigmund</groupId>
      <artifactId>sigmund-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-api</artifactId>
      <version>${resolver.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-spi</artifactId>
      <version>${resolver.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-util</artifactId>
      <version>${resolver.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${sl4j.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>javax.inject</groupId>
      <artifactId>javax.inject</artifactId>
      <version>1</version>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.sisu</groupId>
      <artifactId>org.eclipse.sisu.inject</artifactId>
      <version>${sisu.version}</version>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-test-util</artifactId>
      <version>${resolver.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${sl4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>unpack-it-maven</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/it-maven</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>org.apache.maven</groupId>
                  <artifactId>apache-maven</artifactId>
                  <version>${it.maven3.version}</version>
                  <classifier>bin</classifier>
                  <type>tar.gz</type>
                </artifactItem>
                <artifactItem>
                  <groupId>org.apache.maven</groupId>
                  <artifactId>apache-maven</artifactId>
                  <version>${it.maven4.version}</version>
                  <classifier>bin</classifier>
                  <type>tar.gz</type>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-invoker-plugin</artifactId>
        <version>${maven-invoker-plugin.version}</version>
        <configuration>
          <settingsFile>src/it/settings.xml</settingsFile>
          <pomIncludes>
            <pomInclude>*/pom.xml</pomInclude>
          </pomIncludes>
          <projectsDirectory>src/it</projectsDirectory>
          <properties>
            <maven.repo.local.tail>${settings.localRepository}</maven.repo.local.tail>
          </properties>
          <filterProperties>
            <itRepositoryUrl>${project.baseUri}src/it/fixtures/repo</itRepositoryUrl>
          </filterProperties>
          <scriptVariables>
            <projectVersion>${project.version}</projectVersion>
            <fixtures>${project.basedir}/src/it/fixtures</fixtures>
          </scriptVariables>
          <!-- Scripts use Sigmund core: the signing IT generates a key and verifies what was deployed -->
          <addTestClassPath>true</addTestClassPath>
          <preBuildHookScript>setup</preBuildHookScript>
          <postBuildHookScript>verify</postBuildHookScript>
          <streamLogs>true</streamLogs>
          <!-- An empty user home, so extensions from the developer's ~/.m2/extensions.xml do not load -->
          <mavenOpts>-Duser.home=${project.build.directory}/it-home</mavenOpts>
        </configuration>
        <executions>
          <execution>
            <id>it-maven3</id>
            <goals>
              <goal>install</goal>
              <goal>run</goal>
            </goals>
            <configuration>
              <mavenHome>${project.build.directory}/it-maven/apache-maven-${it.maven3.version}</mavenHome>
              <cloneProjectsTo>${project.build.directory}/it/maven3</cloneProjectsTo>
              <localRepositoryPath>${project.build.directory}/it-repo/maven3</localRepositoryPath>
              <reportsDirectory>${project.build.directory}/invoker-reports/maven3</reportsDirectory>
            </configuration>
          </execution>
          <execution>
            <id>it-maven4</id>
            <goals>
              <goal>install</goal>
              <goal>run</goal>
            </goals>
            <configuration>
              <mavenHome>${project.build.directory}/it-maven/apache-maven-${it.maven4.version}</mavenHome>
              <cloneProjectsTo>${project.build.directory}/it/maven4</cloneProjectsTo>
              <localRepositoryPath>${project.build.directory}/it-repo/maven4</localRepositoryPath>
              <reportsDirectory>${project.build.directory}/invoker-reports/maven4</reportsDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <!-- Resolver's CollectConfiguration reads these tags to render the configuration page -->
          <tags>
            <tag>
              <name>configurationSource</name>
              <placement>f</placement>
              <head>Configuration source:</head>
            </tag>
            <tag>
              <name>configurationType</name>
              <placement>f</placement>
              <head>Configuration type:</head>
            </tag>
            <tag>
              <name>configurationDefaultValue</name>
              <placement>f</placement>
              <head>Default value:</head>
            </tag>
          </tags>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.sisu</groupId>
        <artifactId>sisu-maven-plugin</artifactId>
        <version>${sisu.version}</version>
        <executions>
          <execution>
            <id>index-project</id>
            <goals>
              <goal>main-index</goal>
              <goal>test-index</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.7.0</version>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.resolver</groupId>
            <artifactId>maven-resolver-tools</artifactId>
            <version>${resolver.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>render-configuration-page</id>
            <goals>
              <goal>java</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <includePluginDependencies>true</includePluginDependencies>
              <mainClass>org.eclipse.aether.tools.CollectConfiguration</mainClass>
              <arguments>
                <argument>--mode=resolver</argument>
                <argument>--templates=configuration.md</argument>
                <argument>${basedir}/..</argument>
                <argument>${basedir}/../target/generated-site/markdown/</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
